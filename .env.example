# Matches docker-compose.yml. Point at any PostgreSQL 16+ database.
DATABASE_URL=postgres://taskboard:taskboard@localhost:5432/taskboard

# Frontend (read by Vite from this root folder). The board acts as this seeded user; see the
# seed output for other ids. Alice belongs to Acme only; Sam belongs to Acme and Globex.
VITE_API_URL=http://localhost:4000/
VITE_USER_ID=20000000-0000-4000-8000-000000000001
